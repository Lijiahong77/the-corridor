# ============================================================
#  凭据 —— 绝不入库
#  _secrets/zhipu_key.txt 是明文 API Key，一旦推到公开仓库
#  等于挂在互联网上（爬虫数分钟内就会扫到并盗刷）。
#  这一条没有例外。
# ============================================================
_secrets/
*.key
*.pem
*.pfx
.env
.env.*
*_key.txt
*token*.txt

# ============================================================
#  调试产物 —— 选题材"精简版"，不入库
#    _frames/  验证时抽的帧与截图（41 个，约 34MB）
#    _备选/    实验废案：候选图、失败视频、测试片段（18 个，约 31MB）
#  正式素材在 画面/ 顶层与 音频/，不受影响。
# ============================================================
回廊/画面/_frames/
回廊/画面/_备选/

# ============================================================
#  系统 / 运行时杂物
# ============================================================
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc
.venv/
